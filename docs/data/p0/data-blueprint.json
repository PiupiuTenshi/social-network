{
  "version": "1.0.0-p0",
  "authority": "ADR-0012",
  "databases": [
    {"name": "account_db", "owner": "Account", "credentialBoundary": "account migration/runtime identities"},
    {"name": "social_db", "owner": "Social", "credentialBoundary": "social migration/runtime identities"},
    {"name": "chat_db", "owner": "Chat", "credentialBoundary": "chat migration/runtime identities"},
    {"name": "feed_db", "owner": "Feed", "credentialBoundary": "feed migration/runtime identities"}
  ],
  "tables": [
    {"name": "account", "database": "account_db", "owner": "Account", "aggregate": "Account", "primaryKey": ["id"], "columns": ["id", "email", "password_hash", "status", "version", "created_at", "updated_at"], "foreignKeys": [], "externalReferences": [], "unique": [["email"]], "indexes": [{"columns": ["status"], "accessPattern": "admin status filter"}], "retention": "account lifecycle"},
    {"name": "profile", "database": "account_db", "owner": "Account", "aggregate": "Account", "primaryKey": ["account_id"], "columns": ["account_id", "username", "display_name", "bio", "privacy_level", "version", "updated_at"], "foreignKeys": [{"columns": ["account_id"], "target": "account_db.account"}], "externalReferences": ["avatar_media_id (Media contract only)"], "unique": [["username"]], "indexes": [{"columns": ["username"], "accessPattern": "public profile lookup"}], "retention": "account lifecycle"},
    {"name": "account_setting", "database": "account_db", "owner": "Account", "aggregate": "Account", "primaryKey": ["account_id"], "columns": ["account_id", "notification_json", "locale", "timezone", "policy_version", "version", "updated_at"], "foreignKeys": [{"columns": ["account_id"], "target": "account_db.account"}], "externalReferences": [], "unique": [], "indexes": [], "retention": "account lifecycle"},
    {"name": "refresh_token", "database": "account_db", "owner": "Account", "aggregate": "Session", "primaryKey": ["id"], "columns": ["id", "account_id", "token_hash", "family_id", "expires_at", "revoked_at", "replaced_by_id"], "foreignKeys": [{"columns": ["account_id"], "target": "account_db.account"}], "externalReferences": [], "unique": [], "indexes": [{"columns": ["account_id", "expires_at"], "accessPattern": "session expiry and family revocation"}], "retention": "until expiry plus security retention"},
    {"name": "idempotency_request", "database": "account_db", "owner": "Account", "aggregate": "Request", "primaryKey": ["scope", "idempotency_key"], "columns": ["scope", "idempotency_key", "request_hash", "response_code", "response_body", "created_at", "expires_at"], "foreignKeys": [], "externalReferences": [], "unique": [], "indexes": [{"columns": ["expires_at"], "accessPattern": "TTL cleanup"}], "retention": "24 hours default"},
    {"name": "outbox_message", "database": "account_db", "owner": "Account", "aggregate": "Outbox", "primaryKey": ["id"], "columns": ["id", "aggregate_type", "aggregate_id", "aggregate_version", "event_type", "event_version", "payload_json", "correlation_id", "occurred_at", "published_at", "retry_count", "last_error"], "foreignKeys": [], "externalReferences": [], "unique": [], "indexes": [{"columns": ["published_at", "occurred_at"], "accessPattern": "publisher polling"}, {"columns": ["aggregate_id", "aggregate_version"], "accessPattern": "aggregate audit"}], "retention": "30 days after publish; source state remains authoritative"},

    {"name": "follow", "database": "social_db", "owner": "Social", "aggregate": "Relationship", "primaryKey": ["follower_id", "followee_id"], "columns": ["follower_id", "followee_id", "created_at", "version"], "foreignKeys": [], "externalReferences": ["follower_id and followee_id (Account identity contract)"], "unique": [], "indexes": [{"columns": ["followee_id", "created_at"], "accessPattern": "followers/profile list"}], "retention": "until deleted"},
    {"name": "block", "database": "social_db", "owner": "Social", "aggregate": "Block", "primaryKey": ["blocker_id", "blocked_id"], "columns": ["blocker_id", "blocked_id", "created_at", "version"], "foreignKeys": [], "externalReferences": ["blocker_id and blocked_id (Account identity contract)"], "unique": [], "indexes": [{"columns": ["blocker_id", "created_at"], "accessPattern": "current user block list"}], "retention": "until unblocked"},
    {"name": "post", "database": "social_db", "owner": "Social", "aggregate": "Post", "primaryKey": ["id"], "columns": ["id", "author_id", "content", "type", "visibility", "policy_version", "version", "created_at", "updated_at", "deleted_at"], "foreignKeys": [], "externalReferences": ["author_id (Account identity contract)"], "unique": [], "checks": ["type = 'content' in P0"], "indexes": [{"columns": ["author_id", "created_at", "id"], "accessPattern": "author profile and cursor list"}, {"columns": ["visibility", "created_at", "id"], "accessPattern": "eligible feed candidate scan"}], "retention": "soft delete then retention policy"},
    {"name": "comment", "database": "social_db", "owner": "Social", "aggregate": "Comment", "primaryKey": ["id"], "columns": ["id", "post_id", "author_id", "parent_id", "content", "version", "created_at", "deleted_at"], "foreignKeys": [{"columns": ["post_id"], "target": "social_db.post"}, {"columns": ["parent_id"], "target": "social_db.comment", "nullable": true}], "externalReferences": ["author_id (Account identity contract)"], "unique": [], "indexes": [{"columns": ["post_id", "created_at", "id"], "accessPattern": "post comments cursor list"}], "retention": "soft delete then retention policy"},
    {"name": "reaction", "database": "social_db", "owner": "Social", "aggregate": "Reaction", "primaryKey": ["post_id", "user_id"], "columns": ["post_id", "user_id", "type", "created_at", "updated_at", "version"], "foreignKeys": [{"columns": ["post_id"], "target": "social_db.post"}], "externalReferences": ["user_id (Account identity contract)"], "unique": [], "indexes": [{"columns": ["post_id", "type"], "accessPattern": "post reaction summary"}], "retention": "until removed"},
    {"name": "idempotency_request", "database": "social_db", "owner": "Social", "aggregate": "Request", "primaryKey": ["scope", "idempotency_key"], "columns": ["scope", "idempotency_key", "request_hash", "response_code", "response_body", "created_at", "expires_at"], "foreignKeys": [], "externalReferences": [], "unique": [], "indexes": [{"columns": ["expires_at"], "accessPattern": "TTL cleanup"}], "retention": "24 hours default"},
    {"name": "outbox_message", "database": "social_db", "owner": "Social", "aggregate": "Outbox", "primaryKey": ["id"], "columns": ["id", "aggregate_type", "aggregate_id", "aggregate_version", "event_type", "event_version", "payload_json", "correlation_id", "occurred_at", "published_at", "retry_count", "last_error"], "foreignKeys": [], "externalReferences": [], "unique": [], "indexes": [{"columns": ["published_at", "occurred_at"], "accessPattern": "publisher polling"}], "retention": "30 days after publish; source state remains authoritative"},

    {"name": "conversation", "database": "chat_db", "owner": "Chat", "aggregate": "Conversation", "primaryKey": ["id"], "columns": ["id", "kind", "created_by", "version", "created_at", "updated_at"], "foreignKeys": [], "externalReferences": ["created_by (Account identity contract)", "community_id (Community contract, nullable)"], "unique": [], "indexes": [{"columns": ["updated_at", "id"], "accessPattern": "recent conversation ordering"}], "retention": "conversation retention policy"},
    {"name": "conversation_member", "database": "chat_db", "owner": "Chat", "aggregate": "Conversation", "primaryKey": ["conversation_id", "account_id"], "columns": ["conversation_id", "account_id", "role", "joined_at", "left_at", "version"], "foreignKeys": [{"columns": ["conversation_id"], "target": "chat_db.conversation"}], "externalReferences": ["account_id (Account identity contract)"], "unique": [], "indexes": [{"columns": ["account_id", "left_at", "conversation_id"], "accessPattern": "participant conversation list"}], "retention": "conversation retention policy"},
    {"name": "message", "database": "chat_db", "owner": "Chat", "aggregate": "Message", "primaryKey": ["id"], "columns": ["id", "conversation_id", "sender_id", "client_message_id", "content", "version", "created_at", "edited_at", "deleted_at"], "foreignKeys": [{"columns": ["conversation_id"], "target": "chat_db.conversation"}], "externalReferences": ["sender_id (Account identity contract)"], "unique": [["conversation_id", "sender_id", "client_message_id"]], "indexes": [{"columns": ["conversation_id", "created_at", "id"], "accessPattern": "conversation message cursor list"}], "retention": "soft delete then conversation retention policy"},
    {"name": "message_read_cursor", "database": "chat_db", "owner": "Chat", "aggregate": "Conversation", "primaryKey": ["conversation_id", "account_id"], "columns": ["conversation_id", "account_id", "last_read_message_id", "updated_at", "version"], "foreignKeys": [{"columns": ["conversation_id"], "target": "chat_db.conversation"}], "externalReferences": ["account_id (Account identity contract)"], "unique": [], "indexes": [{"columns": ["account_id", "updated_at"], "accessPattern": "unread summary"}], "retention": "conversation retention policy"},
    {"name": "notification", "database": "chat_db", "owner": "Chat", "aggregate": "Notification", "primaryKey": ["id"], "columns": ["id", "account_id", "kind", "payload_json", "read_at", "created_at", "version"], "foreignKeys": [], "externalReferences": ["account_id (Account identity contract)"], "unique": [], "indexes": [{"columns": ["account_id", "read_at", "created_at", "id"], "accessPattern": "notification list/unread count"}], "retention": "90 days default, subject to policy"},
    {"name": "community_membership_projection", "database": "chat_db", "owner": "Chat", "aggregate": "CommunityMembershipProjection", "primaryKey": ["community_id", "account_id"], "columns": ["community_id", "account_id", "membership_version", "active", "source_event_id", "updated_at"], "foreignKeys": [], "externalReferences": ["community_id (Community contract)", "account_id (Account identity contract)"], "unique": [["source_event_id"]], "indexes": [{"columns": ["account_id", "active", "community_id"], "accessPattern": "community chat authorization"}], "retention": "rebuildable projection"},
    {"name": "inbox_message", "database": "chat_db", "owner": "Chat", "aggregate": "Inbox", "primaryKey": ["consumer_name", "event_id"], "columns": ["consumer_name", "event_id", "event_type", "received_at", "processed_at", "status", "last_error"], "foreignKeys": [], "externalReferences": [], "unique": [], "indexes": [{"columns": ["status", "received_at"], "accessPattern": "retry and DLQ monitoring"}], "retention": "90 days after processed; failures retained per incident policy"},
    {"name": "outbox_message", "database": "chat_db", "owner": "Chat", "aggregate": "Outbox", "primaryKey": ["id"], "columns": ["id", "aggregate_type", "aggregate_id", "aggregate_version", "event_type", "event_version", "payload_json", "correlation_id", "occurred_at", "published_at", "retry_count", "last_error"], "foreignKeys": [], "externalReferences": [], "unique": [], "indexes": [{"columns": ["published_at", "occurred_at"], "accessPattern": "publisher polling"}], "retention": "30 days after publish; source state remains authoritative"},

    {"name": "feed_entry", "database": "feed_db", "owner": "Feed", "aggregate": "FeedProjection", "primaryKey": ["viewer_id", "post_id"], "columns": ["viewer_id", "post_id", "author_id", "published_at", "visibility", "policy_version", "source_version", "version", "rank_key", "deleted_at"], "foreignKeys": [], "externalReferences": ["viewer_id, post_id, author_id (authorized source projections)"], "unique": [], "indexes": [{"columns": ["viewer_id", "rank_key", "post_id"], "accessPattern": "viewer feed cursor"}, {"columns": ["post_id"], "accessPattern": "privacy/delete fan-out"}], "retention": "rebuildable projection"},
    {"name": "feed_user_summary", "database": "feed_db", "owner": "Feed", "aggregate": "FeedProjection", "primaryKey": ["account_id"], "columns": ["account_id", "display_name", "profile_visibility", "policy_version", "source_version", "updated_at"], "foreignKeys": [], "externalReferences": ["account_id (Account source export)"], "unique": [], "indexes": [{"columns": ["policy_version"], "accessPattern": "policy invalidation scan"}], "retention": "rebuildable projection"},
    {"name": "feed_post_summary", "database": "feed_db", "owner": "Feed", "aggregate": "FeedProjection", "primaryKey": ["post_id"], "columns": ["post_id", "author_id", "content", "visibility", "policy_version", "source_version", "published_at", "deleted_at"], "foreignKeys": [], "externalReferences": ["post_id, author_id (Social source export)"], "unique": [], "indexes": [{"columns": ["author_id", "published_at", "post_id"], "accessPattern": "author feed projection and fan-out"}], "retention": "rebuildable projection"},
    {"name": "projection_checkpoint", "database": "feed_db", "owner": "Feed", "aggregate": "ProjectionCheckpoint", "primaryKey": ["projection_name", "source_name"], "columns": ["projection_name", "source_name", "source_export_id", "high_water_mark", "consumer_position", "schema_version", "row_count", "content_hash", "policy_version_min", "policy_version_max", "status", "recorded_at"], "foreignKeys": [], "externalReferences": ["source_export_id (durable source export manifest)"], "unique": [], "indexes": [{"columns": ["status", "recorded_at"], "accessPattern": "latest healthy checkpoint"}], "retention": "retain with backup and rebuild evidence"},
    {"name": "rebuild_run", "database": "feed_db", "owner": "Feed", "aggregate": "ProjectionRebuild", "primaryKey": ["id"], "columns": ["id", "target_namespace", "input_manifest_json", "started_at", "finished_at", "status", "validation_json", "promoted_at", "requested_by"], "foreignKeys": [], "externalReferences": ["input manifests owned by source exports"], "unique": [], "indexes": [{"columns": ["status", "started_at"], "accessPattern": "active rebuild monitoring"}], "retention": "retain with checkpoint history"},
    {"name": "inbox_message", "database": "feed_db", "owner": "Feed", "aggregate": "Inbox", "primaryKey": ["consumer_name", "event_id"], "columns": ["consumer_name", "event_id", "event_type", "received_at", "processed_at", "status", "last_error"], "foreignKeys": [], "externalReferences": [], "unique": [], "indexes": [{"columns": ["status", "received_at"], "accessPattern": "retry and DLQ monitoring"}], "retention": "90 days after processed; failures retained per incident policy"}
  ],
  "projectionPolicy": {"checkpointRequired": true, "exportRequired": true, "promotion": "atomic after validation", "rebuildSource": "authorized source exports plus post-watermark outbox delta", "kafkaIsBackup": false, "onRetentionGap": "full controlled rebuild"},
  "migrationPolicy": {"runner": "one approved runner per logical database", "applicationStartupMigration": false, "strategy": ["expand", "backfill", "switch", "contract"], "p0RpoHours": 24, "p0RtoHours": 4}
}
