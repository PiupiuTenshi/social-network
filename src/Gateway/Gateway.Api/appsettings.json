{
  "Gateway": {
    "Jwt": {
      "Issuer": "https://identity.invalid",
      "Audience": "twilight-api",
      "Authority": "https://identity.invalid"
    },
    "Cors": { "Origins": ["https://app.invalid"] }
  },
  "ReverseProxy": {
    "Routes": {
      "account": {
        "ClusterId": "account",
        "Match": { "Path": "/api/v1/account/{**catch-all}" }
      }
    },
    "Clusters": {
      "account": {
        "Destinations": { "local": { "Address": "http://localhost:5001/" } }
      }
    }
  }
}
